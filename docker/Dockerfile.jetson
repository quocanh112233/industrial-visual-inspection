ARG L4T_TAG=r36.4.0
FROM nvcr.io/nvidia/l4t-jetpack:${L4T_TAG}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip python3-dev \
        libgl1 libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

ARG JETSON_INDEX=https://pypi.jetson-ai-lab.io/jp6/cu126
RUN python3 -m pip install --upgrade pip \
 && python3 -m pip install --index-url ${JETSON_INDEX} onnxruntime-gpu || \
    echo "CANH BAO: khong tai duoc onnxruntime-gpu, backend onnx se chay CPU"

RUN python3 -m pip install \
        "cuda-python<13" \
        "numpy<2.3" opencv-python-headless pillow pyyaml requests \
        fastapi "uvicorn[standard]" python-multipart "pydantic>=2"

COPY src/ /app/src/
COPY configs/ /app/configs/

VOLUME ["/app/models", "/app/data"]

ENV IVID_BACKEND=tensorrt \
    IVID_MODEL=yolov8n \
    IVID_IMGSZ=672 \
    IVID_RESIZE_TO=640 \
    IVID_DEVICE=cuda \
    IVID_MAX_UPLOAD_MB=10

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["python3", "-m", "uvicorn", "ivid.serve.app:app", "--host", "0.0.0.0", "--port", "8000"]
